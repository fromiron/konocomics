{
  "name": "konocomics",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "catalog:normalize": "tsx scripts/normalize-works.ts",
    "catalog:validate": "tsx scripts/validate-catalog.ts",
    "catalog:build": "tsx scripts/build-catalog.ts",
    "catalog:g1-blind-retag": "tsx scripts/build-g1-blind-retag.ts",
    "catalog:g1-candidate": "tsx scripts/build-g1-candidate.ts",
    "catalog:g1-replacement": "tsx scripts/build-g1-replacement.ts",
    "catalog:g2-promote": "node --import tsx scripts/promote-g2-catalog.ts",
    "catalog:coverage": "tsx scripts/report-coverage.ts",
    "experiment:baseline": "tsx scripts/run-baseline-experiment.ts",
    "g2:aggregate": "tsx scripts/aggregate-g2.ts",
    "harness:build": "pnpm --dir harness build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@tanstack/react-router": "1.170.29",
    "@tanstack/react-start": "1.168.46",
    "class-variance-authority": "0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.4.4",
    "dexie-react-hooks": "^4.4.0",
    "fuse.js": "^7.5.0",
    "lucide-react": "1.31.0",
    "motion": "^13.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.0.5",
    "csv-parse": "^7.0.2",
    "eslint": "^9",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "nitro": "3.0.260610-beta",
    "prettier": "^3.9.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "typescript-eslint": "8.66.0",
    "vite": "8.2.1",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.30.3"
}
