{
  "description": "Remind an explicitly assigned Catalog worker once when a saved result lacks a successful queue-send receipt.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 scripts/catalog_authoring/notification_guard.py",
            "commandWindows": "python -X utf8 C:/Toys/konocomics/scripts/catalog_authoring/notification_guard.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
